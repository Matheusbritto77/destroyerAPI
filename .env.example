PORT=3000
DATABASE_PATH=./data/world-records.sqlite
GOOGLE_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com
TOKEN_PEPPER=replace-with-a-64-byte-random-secret
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nPASTE_YOUR_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ALLOWED_ORIGINS=https://your-frontend.example.com
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
LEADERBOARD_CACHE_TTL_MS=15000
